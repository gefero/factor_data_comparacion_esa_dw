calculate_gwstats <- function(sf_object, vars, var_na_filter=2, bwidth=4){
centroids <- st_centroid(sf_object)
centroids <- div_centroids %>%
select(all_of(vars_select)) %>%
filter(is.na(!!sym(vars_select[var_na_filter])))
as("Spatial")
print(centroids)
#gwstats <- gwss(centroids,
#            vars=vars_select,
#            bw = bwidth
#)
return(gwstats)
}
